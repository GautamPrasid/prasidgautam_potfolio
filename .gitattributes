# Normalize line endings to LF in the repo, handle checkout per-OS
* text=auto eol=lf

# Force LF for source files regardless of OS
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.env*  text eol=lf

# Binaries — no line ending conversion
*.jpg   binary
*.jpeg  binary
*.png   binary
*.webp  binary
*.pdf   binary
*.ico   binary
