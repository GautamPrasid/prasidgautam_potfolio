# ============================================================
# .env.local.example
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local — it is listed in .gitignore.
# This example file contains only placeholder values.
# ============================================================

# ── Supabase (required) ──────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Public anon key (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Service role key — server-side ONLY, never expose to the browser
# Used by: app/api/contact/route.ts and app/admin/actions.ts
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# ── Site URL (required for canonical URLs & sitemap) ─────────
# Set to your production domain in Vercel environment variables.
# Do NOT set this to localhost in production.
NEXT_PUBLIC_SITE_URL=https://www.prasidgautam.com.np

# ── Optional: Vercel OIDC (added automatically by Vercel CLI) ─
# VERCEL_OIDC_TOKEN=<added-by-vercel-cli>