# ===================================================
# Git Ignore Configuration
# Stack: Next.js 14, TypeScript, Supabase, Tailwind CSS
# OS Support: Windows, macOS, Linux
# ===================================================

# ── Dependencies ─────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Next.js & Build Artifacts ────────────────────
.next/
out/
build/
.turbo/
.vercel/

# ── TypeScript Build Cache ────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Testing & Coverage ───────────────────────────
coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# ── Environment & Secrets ─────────────────────────
# Never commit credentials or local overrides.
# Keep .env.example committed — it documents required vars without values.
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# ── Supabase CLI ──────────────────────────────────
supabase/.branches/
supabase/.temp/
supabase/functions/.eszip
# Supabase CLI generates this with the local auth JWT secret
supabase/.env

# ── Logs & Temporary Files ────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp
*.bak
*.swp

# ── OS & System Metadata ─────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# Certificates (never commit private keys)
*.pem

# ── Editor & IDE Settings ────────────────────────
# VS Code — allow shared workspace settings, block personal/generated files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
# JetBrains IDEs
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── AI Agent Files ───────────────────────────────
# Agent skill bundles, lock files, and generated docs —
# project-specific AI tooling, not part of the deployable application.
.agents/
skills-lock.json
project-memory.md
decisions.md

.vercel
.env*
